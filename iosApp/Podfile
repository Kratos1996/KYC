platform :ios, '13.0'

install! 'cocoapods', :disable_input_output_paths => true

target 'iosApp' do
  # Remove use_frameworks! OR make it static
  # Option 1: Remove completely (recommended for static KMP framework)
  # Option 2: Use static linkage
  use_frameworks! :linkage => :static
  
  # KMP module - this will pull TensorFlowLiteC as a dependency
  pod 'TensorflowLiteRunner', :path => '../TensorflowLiteRunner'
  pod 'FaceController', :path => '../FaceController'
  #pod 'MRZParser', :path => '../MRZParser'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      
      # For static frameworks
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = '$(inherited)'
      
      # Fix for MLKit linking
      if target.name.include?('MLKit')
        config.build_settings['DEFINES_MODULE'] = 'YES'
        config.build_settings['MODULAR_HEADERS'] = 'YES'
      end
      
      # Fix for undefined symbols
      config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
      config.build_settings['OTHER_LDFLAGS'] << '-ObjC'
      config.build_settings['OTHER_LDFLAGS'] << '-lc++'
    end
  end
end
